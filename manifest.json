{
  "manifest_version": 3,
  "name": "Ambient Light for 動画配信",
  "version": "1.0.0",
  "description": "TVer・ニコニコ動画・ABEMAなどの動画再生画面に、映像の色に合わせて光るアンビエントライト効果を追加する非公式の拡張機能です。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tver.jp/*",
        "https://abema.tv/*",
        "https://www.nicovideo.jp/*"
      ],
      "css": ["content/ambient.css"],
      "js": ["content/ambient.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://tver.jp/*",
    "https://abema.tv/*",
    "https://www.nicovideo.jp/*"
  ]
}
